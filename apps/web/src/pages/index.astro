		<script>
			// 1. Live GitHub stars fetch (silent fallback when placeholder repo is 404; never invent numbers)
			const ghLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-github-link]")];
			const repo = ghLinks[0]?.dataset.repo;
			if (repo) {
				fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: "application/vnd.github+json" } })
					.then((r) => (r.ok ? r.json() : null))
					.then((data) => {
						if (!data || typeof data.stargazers_count !== "number") return;
						const formatted = new Intl.NumberFormat("en", { notation: "compact" }).format(data.stargazers_count);
						for (const link of ghLinks) {
							const badge = link.querySelector<HTMLElement>("[data-star-badge]");
							const num = link.querySelector<HTMLElement>("[data-star-number]");
							if (badge && num) {
								num.textContent = formatted;
								badge.hidden = false;
							}
						}
					})
					.catch(() => {});
			}

			// 3. Animated White Desktop App Flow + Gliding Tab Slider Below
			type FlowStep = "coding" | "headsup" | "break" | "done";
			const FLOW_ORDER: FlowStep[] = ["coding", "headsup", "break", "done"];
			const FLOW_META: Record<FlowStep, { duration: number; tray: string; caption: string }> = {
				coding: {
					duration: 4200,
					tray: "Pebni · 14:20",
					caption: "Pebni stays completely out of your way in the menu bar while you write code on your own schedule.",
				},
				headsup: {
					duration: 4400,
					tray: "Break in 0:30",
					caption: "Right before a break, a quiet corner heads-up gives you a moment to finish your thought without startling you.",
				},
				break: {
					duration: 5800,
					tray: "On break",
					caption: "Then your whole screen opens into a calm cabin break with optional Hide Skip, stories, meditation, or guided breathing.",
				},
				done: {
					duration: 3800,
					tray: "Next round",
					caption: "Once your break is done, the cabin fades away and puts you right back at your cursor with rested eyes.",
				},
			};

			const flowDesktop = document.getElementById("flow-desktop");
			const flowTabsWrap = document.getElementById("flow-tabs");
			const flowSlider = document.getElementById("flow-tab-slider");
			const flowCaption = document.getElementById("flow-caption");
			const trayStatus = document.getElementById("tray-status");
			const flowToggle = document.getElementById("flow-toggle");
			const breakClockEl = document.getElementById("preview-ui-clock");
			const breathCueEl = document.getElementById("preview-breath-cue");
			const flowTabs = [...document.querySelectorAll<HTMLButtonElement>(".flow-tab")];

			let flowIndex = 0;
			let flowPaused = matchMedia("(prefers-reduced-motion: reduce)").matches;
			let flowTimeout: number | undefined;
			let breakTickInterval: number | undefined;
			let breakSeconds = 20;

			function formatSec(n: number) {
				return n < 10 ? "0:0" + n : "0:" + n;
			}

			function positionSlider(tab: HTMLButtonElement) {
				if (!flowSlider) return;
				flowSlider.style.width = `${tab.offsetWidth}px`;
				flowSlider.style.transform = `translateX(${tab.offsetLeft - 6}px)`;
			}

			function clearFlowTimers() {
				if (flowTimeout) window.clearTimeout(flowTimeout);
				if (breakTickInterval) window.clearInterval(breakTickInterval);
				flowTimeout = undefined;
				breakTickInterval = undefined;
			}

			function applyFlowStep(index: number, animateCaption = true) {
				clearFlowTimers();
				flowIndex = (index + FLOW_ORDER.length) % FLOW_ORDER.length;
				const step = FLOW_ORDER[flowIndex];
				const meta = FLOW_META[step];

				if (flowDesktop) flowDesktop.dataset.step = step;
				if (trayStatus) trayStatus.textContent = meta.tray;

				flowTabs.forEach((btn, i) => {
					const active = i === flowIndex;
					btn.setAttribute("aria-selected", String(active));
					btn.style.setProperty("--step-dur", `${meta.duration}ms`);
					const bar = btn.querySelector<HTMLElement>(".flow-tab-progress");
					if (bar) {
						bar.style.animation = "none";
						void bar.offsetWidth;
						bar.style.animation = "";
					}
					if (active) positionSlider(btn);
				});

				if (flowCaption) {
					if (animateCaption) {
						flowCaption.classList.add("is-swapping");
						window.setTimeout(() => {
							flowCaption.textContent = meta.caption;
							flowCaption.classList.remove("is-swapping");
						}, 140);
					} else {
						flowCaption.textContent = meta.caption;
					}
				}

				if (step === "break") {
					breakSeconds = 20;
					if (breakClockEl) breakClockEl.textContent = "0:20";
					if (breathCueEl) breathCueEl.textContent = "Breathe in slowly";
					breakTickInterval = window.setInterval(() => {
						breakSeconds = Math.max(1, breakSeconds - 1);
						if (breakClockEl) breakClockEl.textContent = formatSec(breakSeconds);
						if (breathCueEl) {
							const phase = (20 - breakSeconds) % 6;
							breathCueEl.textContent = phase < 3 ? "Breathe in slowly" : "Breathe out slowly";
						}
					}, 1000);
				}

				if (!flowPaused) {
					flowTimeout = window.setTimeout(() => applyFlowStep(flowIndex + 1), meta.duration);
				}
			}

			flowTabs.forEach((tab, idx) => {
				tab.addEventListener("click", () => applyFlowStep(idx));
			});

			flowToggle?.addEventListener("click", () => {
				flowPaused = !flowPaused;
				flowTabsWrap?.classList.toggle("is-paused", flowPaused);
				if (flowToggle) flowToggle.textContent = flowPaused ? "Play flow" : "Pause flow";
				if (flowPaused) {
					clearFlowTimers();
				} else {
					applyFlowStep(flowIndex, false);
				}
			});

			// Proportionally scale the 960x540 macOS desktop stage cleanly to any viewport (true 16:9 on mobile too)
			function scaleDesktopStage() {
				if (!flowDesktop) return;
				const scale = flowDesktop.clientWidth / 960;
				flowDesktop.style.setProperty("--stage-scale", String(scale));
			}

			window.addEventListener("resize", () => {
				scaleDesktopStage();
				const active = flowTabs[flowIndex];
				if (active) positionSlider(active);
			});

			if (flowDesktop && "ResizeObserver" in window) {
				new ResizeObserver(scaleDesktopStage).observe(flowDesktop);
			}
			scaleDesktopStage();

			if (flowPaused) {
				flowTabsWrap?.classList.add("is-paused");
				if (flowToggle) flowToggle.textContent = "Play flow";
			}
			applyFlowStep(0, false);

			// 4. Interactive toggle switches inside the bento settings mockup
			document.querySelectorAll<HTMLButtonElement>(".mock-switch").forEach((sw) => {
				sw.addEventListener("click", () => {
					const next = sw.getAttribute("aria-checked") !== "true";
					sw.setAttribute("aria-checked", String(next));
				});
			});

			// 5. Scroll reveals (with passive scroll fallback so long pages never leave a block hidden)
			const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
			const reveals = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
			function revealVisible() {
				const cutoff = window.innerHeight * 1.12;
				for (const el of reveals) {
					if (!el.classList.contains("is-in") && el.getBoundingClientRect().top <= cutoff) {
						el.classList.add("is-in");
					}
				}
			}
			if (reduced || !("IntersectionObserver" in window)) {
				reveals.forEach((el) => el.classList.add("is-in"));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add("is-in");
								io.unobserve(e.target);
							}
						}
					},
					{ rootMargin: "0px 0px 14% 0px", threshold: 0.01 },
				);
				reveals.forEach((el) => io.observe(el));
				window.addEventListener("scroll", revealVisible, { passive: true });
				revealVisible();
			}
		</script>
		<Analytics />
	</body>
</html>
