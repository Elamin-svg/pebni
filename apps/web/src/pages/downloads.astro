---
import "../styles/pebni.css";

// Repository slug: update via `node scripts/release.mjs <ver> --repo owner/repo` when publishing.
const GITHUB_REPO = "Elamin-svg/pebni";
const GITHUB_URL = `https://github.com/${GITHUB_REPO}`;
const DOWNLOAD_WIN_URL = `${GITHUB_URL}/releases/latest/download/win-x64-Pebni-Setup.zip`;
const RELEASES_URL = `${GITHUB_URL}/releases/latest`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Get Pebni for Windows (macOS coming soon)</title>
		<meta
			name="description"
			content="Download Pebni for Windows, or inspect and build the MIT open-source break companion directly from GitHub. macOS coming soon."
		/>
		<link rel="icon" type="image/png" href="/art/logo.png" />
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/bricolage-grotesque-latin-wght-normal.woff2"
			crossorigin
		/>
		<script is:inline>document.documentElement.classList.add("js");</script>
	</head>
	<body>
		<header class="wrap">
			<nav class="site-nav" aria-label="Primary">
				<a class="wordmark" href="/">
					<img src="/art/logo.png" alt="" width="36" height="36" />
					<span>Pebni</span>
				</a>
				<ul class="nav-links">
					<li><a href="/">Home</a></li>
					<li><a href="/#preview">Live demo</a></li>
					<li><a href="/#faq">FAQ</a></li>
					<li><a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a></li>
				</ul>
			</nav>
		</header>

		<main class="wrap downloads-main">
			<section class="downloads-hero" aria-labelledby="downloads-heading">
				<div class="downloads-copy">
					<h1 id="downloads-heading">
						<span class="line"><span data-line style="--i:0">Get Pebni</span></span>
						<span class="line"><span data-line style="--i:1">for desktop.</span></span>
					</h1>
					<p data-load style="--d:200ms">
						Free, open-source break companion for developers with custom break lengths, 20-20-20, and Pomodoro presets. Available for Windows today — macOS coming soon.
					</p>
				</div>

				<figure class="downloads-art" data-load style="--d:260ms">
					<div class="downloads-art-frame">
						<video
							src="/art/break-morning-window.webm"
							poster="/art/break-morning-window.jpg"
							autoplay
							muted
							loop
							playsinline
						></video>
					</div>
				</figure>
			</section>

			<section aria-labelledby="choose-platform">
				<h2 id="choose-platform" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">
					Choose your platform
				</h2>

				<div class="downloads-list">
					<article id="windows" class="download-row download-row--featured" data-os-card="windows" data-load style="--d:300ms">
						<figure class="download-row-art" data-load style="--d:320ms">
							<img src="/art/story-presets.jpg" alt="Pebni sipping coffee next to a wooden hourglass and timer" width="320" height="240" />
						</figure>
						<div data-load style="--d:340ms">
							<h2>Windows <span class="download-row-tag" data-win-version>Windows 10 &amp; 11</span></h2>
							<p>Official Electrobun desktop installer (.zip — unzip and run Pebni-Setup.exe) with automatic background updates, system tray timer, fullscreen breaks, and offline audio.</p>
						</div>
						<a
							class="btn btn-install"
							href={DOWNLOAD_WIN_URL}
							data-win-download
							data-repo={GITHUB_REPO}
							data-fallback={RELEASES_URL}
							data-load
							style="--d:360ms"
						>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 3v12" />
								<path d="m7 10 5 5 5-5" />
								<path d="M5 20h14" />
							</svg>
							<span data-win-btn-label>Download for Windows</span>
						</a>
					</article>

					<article id="macos" class="download-row" data-os-card="macos" data-load style="--d:360ms">
						<figure class="download-row-art" data-load style="--d:380ms">
							<img src="/art/benefit-evening-eyes.jpg" alt="Pebni coding comfortably in a warm dusk cabin" width="320" height="240" />
						</figure>
						<div data-load style="--d:400ms">
							<h2>macOS <span class="download-row-tag">Coming soon</span></h2>
							<p>macOS support is coming soon once testing on Mac hardware is complete. Watch GitHub releases for updates.</p>
						</div>
						<span class="btn btn-soft" aria-disabled="true" data-load style="--d:420ms">Coming soon</span>
					</article>

					<article class="download-row" data-load style="--d:420ms">
						<figure class="download-row-art" data-load style="--d:440ms">
							<img src="/art/benefit-calls-flow.jpg" alt="Pebni wearing a headset on a video call in a sunlit cabin" width="320" height="240" />
						</figure>
						<div data-load style="--d:460ms">
							<h2>Build from GitHub <span class="download-row-tag">MIT Open Source</span></h2>
							<p>Inspect every line of TypeScript, check releases, or clone and run the desktop app from source.</p>
						</div>
						<a
							class="btn btn-github"
							href={GITHUB_URL}
							target="_blank"
							rel="noreferrer"
							data-github-link
							data-repo={GITHUB_REPO}
							data-load
							style="--d:480ms"
						>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.6-2.81 5.63-5.49 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" />
							</svg>
							<span>Go to GitHub</span>
							<span class="star-count" data-star-badge hidden>
								<svg viewBox="0 0 24 24" fill="currentColor" style="width:0.85rem;height:0.85rem" aria-hidden="true">
									<path d="m12 2.5 2.93 5.94 6.56.95-4.74 4.62 1.12 6.53L12 17.46l-5.87 3.08 1.12-6.53L2.51 9.39l6.56-.95L12 2.5Z" />
								</svg>
								<span data-star-number></span>
							</span>
						</a>
					</article>
				</div>

				<div class="downloads-note" data-load style="--d:500ms">
					<span>Free under MIT · Automatic updates built in · All settings stay locally on your device.</span>
					<a href="/">Back to overview</a>
				</div>
			</section>
		</main>

		<script>
			// Live latest GitHub Release fetch: automatically updates the Windows download link and version badge.
			const winBtn = document.querySelector<HTMLAnchorElement>("[data-win-download]");
			const winTag = document.querySelector<HTMLElement>("[data-win-version]");
			const winRepo = winBtn?.dataset.repo;
			if (winRepo && winBtn) {
				fetch(`https://api.github.com/repos/${winRepo}/releases/latest`, {
					headers: { Accept: "application/vnd.github+json" },
				})
					.then((r) => (r.ok ? r.json() : null))
					.then((rel) => {
						if (!rel || !Array.isArray(rel.assets)) return;
						// Prefer Electrobun's complete Setup zip (contains Pebni-Setup.exe + .installer/ payload).
						const zip = rel.assets.find((a: { name?: string }) => /win-x64.*\.zip$/i.test(a.name || ""));
						const exe = rel.assets.find((a: { name?: string }) => /\.exe$/i.test(a.name || ""));
						const asset = zip || exe;
						if (asset?.browser_download_url) winBtn.href = asset.browser_download_url;
						else if (winBtn.dataset.fallback) winBtn.href = winBtn.dataset.fallback;
						if (winTag && rel.tag_name) {
							const sizeMb = asset?.size ? ` · ${(asset.size / (1024 * 1024)).toFixed(1)} MB` : "";
							winTag.textContent = `Windows 10 & 11 · ${rel.tag_name}${sizeMb}`;
						}
					})
					.catch(() => {});
			}

			// Live GitHub star count fetch (silent when placeholder repo is 404)
			const ghLink = document.querySelector<HTMLAnchorElement>("[data-github-link]");
			const repo = ghLink?.dataset.repo;
			if (repo && ghLink) {
				fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: "application/vnd.github+json" } })
					.then((r) => (r.ok ? r.json() : null))
					.then((data) => {
						if (!data || typeof data.stargazers_count !== "number") return;
						const formatted = new Intl.NumberFormat("en", { notation: "compact" }).format(data.stargazers_count);
						const badge = ghLink.querySelector<HTMLElement>("[data-star-badge]");
						const num = ghLink.querySelector<HTMLElement>("[data-star-number]");
						if (badge && num) {
							num.textContent = formatted;
							badge.hidden = false;
						}
					})
					.catch(() => {});
			}
		</script>
	</body>
</html>
